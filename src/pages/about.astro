---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "@/components/Icon";
import { IconBox } from "@/components/IconBox";
import {
  SecurityLockIcon,
  CreditCardIcon,
  AnalyticsUpIcon,
  Tick02Icon,
  CheckmarkCircle01Icon,
  RocketIcon,
  DollarSquareIcon,
  Shield01Icon,
  GithubIcon,
} from "@hugeicons/core-free-icons";
---

<BaseLayout title="About - IQ  Key Value">
  <div class="container mx-auto px-4 py-16 max-w-4xl">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">About IQ  Key Value</h1>
      <p class="text-lg max-w-2xl mx-auto">
        Enterprise microservices platform that eliminates months of
        infrastructure development, letting you focus on building unique
        business value from day one.
      </p>
    </div>

    <div class="space-y-12">
      <section class="card bg-base-200 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl">Our Mission</h2>
          <p>
            We believe every SaaS founder should spend their time solving
            customer problems, not rebuilding authentication systems, payment
            infrastructure, and CRM pipelines. IQ  Key Value provides the
            essential business infrastructure so you can launch faster and scale
            confidently.
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-6">What We Provide</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <IconBox icon={SecurityLockIcon} client:load />
              <h3 class="card-title">Identity & Access Management</h3>
              <p>
                Multi-tenant authentication, role-based access control, and
                secure user lifecycle management
              </p>
            </div>
          </div>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <IconBox icon={CreditCardIcon} client:load />
              <h3 class="card-title">Financial Operations</h3>
              <p>
                Payment processing, subscription management, merchant
                onboarding, and revenue sharing
              </p>
            </div>
          </div>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <IconBox icon={AnalyticsUpIcon} client:load />
              <h3 class="card-title">CRM & Sales Pipeline</h3>
              <p>
                Lead capture, scoring, conversion tracking, and sales analytics
              </p>
            </div>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-6">Who We Serve</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="flex items-start gap-3 card bg-base-100 shadow">
            <div class="card-body flex-row items-center gap-3 py-4">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0"
                client:load
              />
              <span>B2B SaaS companies needing multi-tenant infrastructure</span
              >
            </div>
          </div>
          <div class="flex items-start gap-3 card bg-base-100 shadow">
            <div class="card-body flex-row items-center gap-3 py-4">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0"
                client:load
              />
              <span>Marketplace platforms requiring merchant onboarding</span>
            </div>
          </div>
          <div class="flex items-start gap-3 card bg-base-100 shadow">
            <div class="card-body flex-row items-center gap-3 py-4">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0"
                client:load
              />
              <span>Startups wanting to launch MVPs in weeks, not months</span>
            </div>
          </div>
          <div class="flex items-start gap-3 card bg-base-100 shadow">
            <div class="card-body flex-row items-center gap-3 py-4">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0"
                client:load
              />
              <span
                >Enterprises modernizing legacy systems with microservices</span
              >
            </div>
          </div>
          <div class="flex items-start gap-3 card bg-base-100 shadow">
            <div class="card-body flex-row items-center gap-3 py-4">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0"
                client:load
              />
              <span>Development teams seeking production-ready patterns</span>
            </div>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold mb-6">Why Choose IQ  Key Value</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <IconBox icon={CheckmarkCircle01Icon} size={20} client:load />
              <h3 class="card-title">Production Ready</h3>
              <p>
                Battle-tested patterns with security, scalability, and
                observability built in
              </p>
            </div>
          </div>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <IconBox icon={RocketIcon} size={20} client:load />
              <h3 class="card-title">Time to Market</h3>
              <p>
                Launch in weeks instead of months by skipping infrastructure
                development
              </p>
            </div>
          </div>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <IconBox icon={DollarSquareIcon} size={20} client:load />
              <h3 class="card-title">Cost Effective</h3>
              <p>
                Avoid expensive trial-and-error with proven architectural
                patterns
              </p>
            </div>
          </div>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <IconBox icon={Shield01Icon} size={20} client:load />
              <h3 class="card-title">Compliance Ready</h3>
              <p>
                Data isolation, audit trails, and security controls for
                regulated industries
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="card bg-base-200 shadow-xl">
        <div class="card-body text-center">
          <h2 class="card-title text-2xl justify-center">Get Started Today</h2>
          <p class="max-w-2xl mx-auto">
            Join companies building faster with IQ  Key Value. Whether you're
            launching an MVP or scaling to enterprise, we provide the
            infrastructure foundation you need to succeed.
          </p>
          <div class="card-actions justify-center">
            <a
              href="https://github.com/IQKV/microservices-platform"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary gap-2"
            >
              <Icon icon={GithubIcon} size={20} client:load />
              View on GitHub
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
