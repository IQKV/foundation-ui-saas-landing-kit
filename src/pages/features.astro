---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "@/components/Icon";
import { IconBox } from "@/components/IconBox";
import {
  UserIcon,
  Globe02Icon,
  CreditCardIcon,
  UserMultipleIcon,
  AnalyticsUpIcon,
  Tick02Icon,
  Shield01Icon,
  RocketIcon,
  ViewIcon,
  PuzzleIcon,
} from "@hugeicons/core-free-icons";
---

<BaseLayout title="Platform Services - IQ Scaffold">
  <div class="container mx-auto px-4 py-16">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold mb-4">Platform Services</h1>
      <p class="text-lg max-w-2xl mx-auto">
        Six production-ready microservices covering essential business
        operations
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <IconBox icon={UserIcon} client:load />
          <h2 class="card-title">User Service</h2>
          <p>
            Centralized identity and access management for your entire platform.
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Secure authentication with email verification</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Role-based access control for teams and organizations</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Multi-tenant user isolation</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Password reset and account security</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Complete audit trails for compliance</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <IconBox icon={Globe02Icon} client:load />
          <h2 class="card-title">Gateway Service</h2>
          <p>
            Intelligent API gateway protecting and routing all platform traffic.
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Automatic rate limiting to prevent abuse</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Circuit breakers for service resilience</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Request routing and load balancing</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Multi-tenant request isolation</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Real-time monitoring and alerts</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <IconBox icon={CreditCardIcon} client:load />
          <h2 class="card-title">Billing Service</h2>
          <p>
            Complete payment operations from one-time charges to complex revenue
            sharing.
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Accept payments with multiple payment gateways</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Manage subscriptions with automated billing</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Onboard merchants with Stripe Connect</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Handle refunds and disputes automatically</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Revenue sharing and platform fees</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Invoice generation and tracking</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <IconBox icon={AnalyticsUpIcon} client:load />
          <h2 class="card-title">Lead Service</h2>
          <p>Capture, qualify, and convert leads into customers efficiently.</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Multi-source lead capture and tracking</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Automatic lead scoring (0-100)</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Lead assignment to sales teams</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Qualification workflows</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Seamless conversion to contacts</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <IconBox icon={UserMultipleIcon} client:load />
          <h2 class="card-title">Contact Service</h2>
          <p>Comprehensive contact management with bulk operations support.</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Complete contact lifecycle management</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Bulk operations for efficiency</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Company associations and relationships</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Lead conversion tracking</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Activity history and notes</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <IconBox icon={AnalyticsUpIcon} client:load />
          <h2 class="card-title">Pipeline Service</h2>
          <p>
            Sales pipeline management with analytics and conversion tracking.
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Customizable pipeline stages</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Follow-up scheduling and reminders</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Real-time conversion analytics</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Sales velocity tracking</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Team performance dashboards</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <section class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <h2 class="card-title text-2xl mb-6 justify-center">
          Cross-Platform Capabilities
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex items-start gap-3">
            <IconBox icon={Shield01Icon} size={20} client:load />
            <div>
              <h3 class="font-semibold mb-2">Security & Compliance</h3>
              <p class="text-sm">
                Multi-tenant data isolation, encrypted credentials, audit
                logging, and role-based access control
              </p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <IconBox icon={RocketIcon} size={20} client:load />
            <div>
              <h3 class="font-semibold mb-2">Scalability & Performance</h3>
              <p class="text-sm">
                Distributed caching, rate limiting, circuit breakers, and
                independent service scaling
              </p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <IconBox icon={ViewIcon} size={20} client:load />
            <div>
              <h3 class="font-semibold mb-2">Observability</h3>
              <p class="text-sm">
                Distributed tracing, metrics collection, structured logging, and
                real-time monitoring
              </p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <IconBox icon={PuzzleIcon} size={20} client:load />
            <div>
              <h3 class="font-semibold mb-2">Integration Ready</h3>
              <p class="text-sm">
                Event-driven architecture, REST APIs, webhook support, and
                standardized error handling
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
