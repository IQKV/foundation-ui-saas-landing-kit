---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AnimatedSection } from "@/components/AnimatedSection";
import { FeatureCard } from "@/components/FeatureCard";
import { IconBox } from "@/components/IconBox";
import {
  UserIcon,
  Globe02Icon,
  CreditCardIcon,
  UserMultipleIcon,
  AnalyticsUpIcon,
  Shield01Icon,
  RocketIcon,
  ViewIcon,
  PuzzleIcon,
} from "@hugeicons/core-free-icons";
---

<BaseLayout title="Platform Services - IQ  Key Value">
  <div class="container mx-auto px-4 py-16">
    <AnimatedSection client:load>
      <div class="text-center mb-16">
        <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">
          Platform Services
        </h1>
        <p class="text-xl max-w-2xl mx-auto text-base-content/70">
          Six production-ready microservices covering essential business operations
        </p>
      </div>
    </AnimatedSection>

    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <FeatureCard
        icon={UserIcon}
        title="User Service"
        description="Centralized identity and access management for your entire platform."
        features={[
          "Secure authentication with email verification",
          "Role-based access control for teams and organizations",
          "Multi-tenant user isolation",
          "Password reset and account security",
          "Complete audit trails for compliance",
        ]}
        delay={0.1}
        client:load
      />

      <FeatureCard
        icon={Globe02Icon}
        title="Gateway Service"
        description="Intelligent API gateway protecting and routing all platform traffic."
        features={[
          "Automatic rate limiting to prevent abuse",
          "Circuit breakers for service resilience",
          "Request routing and load balancing",
          "Multi-tenant request isolation",
          "Real-time monitoring and alerts",
        ]}
        delay={0.2}
        client:load
      />

      <FeatureCard
        icon={CreditCardIcon}
        title="Billing Service"
        description="Complete payment operations from one-time charges to complex revenue sharing."
        features={[
          "Accept payments with multiple payment gateways",
          "Manage subscriptions with automated billing",
          "Onboard merchants with Stripe Connect",
          "Handle refunds and disputes automatically",
          "Revenue sharing and platform fees",
          "Invoice generation and tracking",
        ]}
        delay={0.3}
        client:load
      />

      <FeatureCard
        icon={AnalyticsUpIcon}
        title="Lead Service"
        description="Capture, qualify, and convert leads into customers efficiently."
        features={[
          "Multi-source lead capture and tracking",
          "Automatic lead scoring (0-100)",
          "Lead assignment to sales teams",
          "Qualification workflows",
          "Seamless conversion to contacts",
        ]}
        delay={0.4}
        client:load
      />

      <FeatureCard
        icon={UserMultipleIcon}
        title="Contact Service"
        description="Comprehensive contact management with bulk operations support."
        features={[
          "Complete contact lifecycle management",
          "Bulk operations for efficiency",
          "Company associations and relationships",
          "Lead conversion tracking",
          "Activity history and notes",
        ]}
        delay={0.5}
        client:load
      />

      <FeatureCard
        icon={AnalyticsUpIcon}
        title="Pipeline Service"
        description="Sales pipeline management with analytics and conversion tracking."
        features={[
          "Customizable pipeline stages",
          "Follow-up scheduling and reminders",
          "Real-time conversion analytics",
          "Sales velocity tracking",
          "Team performance dashboards",
        ]}
        delay={0.6}
        client:load
      />
    </div>

    <AnimatedSection client:load delay={0.3}>
      <section class="card bg-gradient-to-br from-base-200 to-base-100 shadow-xl border border-base-300/50">
        <div class="card-body">
          <h2 class="card-title text-3xl mb-8 justify-center bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
            Cross-Platform Capabilities
          </h2>
          <div class="grid md:grid-cols-2 gap-8">
            <div class="flex items-start gap-4 p-4 rounded-lg hover:bg-base-100 transition-colors">
              <IconBox icon={Shield01Icon} size={20} client:load />
              <div>
                <h3 class="font-semibold mb-2 text-lg">Security & Compliance</h3>
                <p class="text-sm text-base-content/70">
                  Multi-tenant data isolation, encrypted credentials, audit
                  logging, and role-based access control
                </p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-4 rounded-lg hover:bg-base-100 transition-colors">
              <IconBox icon={RocketIcon} size={20} client:load />
              <div>
                <h3 class="font-semibold mb-2 text-lg">Scalability & Performance</h3>
                <p class="text-sm text-base-content/70">
                  Distributed caching, rate limiting, circuit breakers, and
                  independent service scaling
                </p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-4 rounded-lg hover:bg-base-100 transition-colors">
              <IconBox icon={ViewIcon} size={20} client:load />
              <div>
                <h3 class="font-semibold mb-2 text-lg">Observability</h3>
                <p class="text-sm text-base-content/70">
                  Distributed tracing, metrics collection, structured logging, and
                  real-time monitoring
                </p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-4 rounded-lg hover:bg-base-100 transition-colors">
              <IconBox icon={PuzzleIcon} size={20} client:load />
              <div>
                <h3 class="font-semibold mb-2 text-lg">Integration Ready</h3>
                <p class="text-sm text-base-content/70">
                  Event-driven architecture, REST APIs, webhook support, and
                  standardized error handling
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </AnimatedSection>
  </div>
</BaseLayout>
