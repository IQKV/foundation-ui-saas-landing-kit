---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AnimatedHero } from "@/components/AnimatedHero";
import { AnimatedCard } from "@/components/AnimatedCard";
import { AnimatedSection } from "@/components/AnimatedSection";
import { Icon } from "@/components/Icon";
import {
  SecurityLockIcon,
  CreditCardIcon,
  Globe02Icon,
  RocketIcon,
  Shield01Icon,
  DollarSquareIcon,
  Settings01Icon,
  Book01Icon,
  Activity03Icon,
  Database01Icon,
  UserIcon,
  MessageIcon,
  RefreshIcon,
} from "@hugeicons/core-free-icons";
---

<BaseLayout title="IQ Key Value — Hybrid Tenancy SaaS Foundation">
  <!-- Hero -->
  <AnimatedHero client:load />

  <!-- Four core services -->
  <div class="container mx-auto px-4">
    <AnimatedSection client:load>
      <section class="py-20">
        <h2 class="text-4xl font-bold text-center mb-4 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
          Four Production-Ready Services
        </h2>
        <p class="text-center text-base-content/60 mb-12 text-lg">
          Each service ships with its own Helm chart, CI/CD pipeline, and dedicated database
        </p>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <AnimatedCard
            icon={SecurityLockIcon}
            title="IAM Service"
            description="Full identity lifecycle — signup, JWT RS256 auth, multi-tenant membership, token exchange, avatar uploads, announcements, and in-app notifications."
            delay={0.1}
            client:load
          />
          <AnimatedCard
            icon={Globe02Icon}
            title="Gateway Service"
            description="Reactive Spring Cloud Gateway — JWT validation via JWKS, header sanitization, audit context propagation, per-tenant metrics, and Swagger aggregation."
            delay={0.2}
            client:load
          />
          <AnimatedCard
            icon={CreditCardIcon}
            title="Billing Service"
            description="Gateway-agnostic payment abstraction — Stripe integration, per-tenant customer provisioning, subscription lifecycle, refunds API, and Customer Portal sessions."
            delay={0.3}
            client:load
          />
          <AnimatedCard
            icon={Book01Icon}
            title="Audit Service"
            description="Centralized event-driven audit trail — passive RabbitMQ consumption, SPI-based extensibility, JSONB metadata, and PLATFORM_ADMIN search API."
            delay={0.4}
            client:load
          />
        </div>
      </section>
    </AnimatedSection>

    <!-- Hybrid tenancy highlight -->
    <AnimatedSection client:load delay={0.1}>
      <section class="py-16">
        <div class="card bg-gradient-to-br from-primary/5 to-secondary/5 border border-primary/20 shadow-xl">
          <div class="card-body md:flex-row items-center gap-8">
            <div class="flex-1">
              <h2 class="text-3xl font-bold mb-3 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                Hybrid Tenancy Model
              </h2>
              <p class="text-base-content/70 mb-4">
                Deploy as <strong>multi-tenant B2B SaaS</strong> (schema-per-tenant PostgreSQL isolation)
                or <strong>single-tenant B2C</strong> (all users in one default workspace) — from the
                same codebase. Switch via a single config flag, no code changes required.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="badge badge-primary badge-lg">Multi-Tenant B2B</span>
                <span class="badge badge-secondary badge-lg">Single-Tenant B2C</span>
                <span class="badge badge-outline badge-lg">Schema-Per-Tenant</span>
                <span class="badge badge-outline badge-lg">RabbitMQ Provisioning</span>
              </div>
            </div>
            <div class="flex-shrink-0">
              <AnimatedCard
                icon={Settings01Icon}
                title="One flag, two models"
                description="platform.rolloutMode: MULTI_TENANT or SINGLE_TENANT"
                size={20}
                client:load
              />
            </div>
          </div>
        </div>
      </section>
    </AnimatedSection>

    <AnimatedSection client:load delay={0.15}>
      <section class="py-20">
        <h2 class="text-4xl font-bold text-center mb-4 bg-gradient-to-r from-secondary to-accent bg-clip-text text-transparent">
          Administration & Self-Service
        </h2>
        <p class="text-center text-base-content/60 mb-12 text-lg">
          Complete platform management, tenant self-service, and centralized observability
        </p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <AnimatedCard
            icon={Activity03Icon}
            title="Centralized Audit Trail"
            description="Passive event consumption from RabbitMQ, SPI-based extensibility, PLATFORM_ADMIN search API with JSONB metadata."
            delay={0.1}
            size={20}
            client:load
          />
          <AnimatedCard
            icon={MessageIcon}
            title="Global Announcements"
            description="Multi-lingual announcements with async fan-out, real-time WebSocket push, and delivery tracking."
            delay={0.2}
            size={20}
            client:load
          />
          <AnimatedCard
            icon={Shield01Icon}
            title="In-App Notifications"
            description="Persistent notifications with unread badges, mark-as-read, dismiss, and real-time WebSocket delivery."
            delay={0.3}
            size={20}
            client:load
          />
          <AnimatedCard
            icon={RefreshIcon}
            title="Token Exchange"
            description="Seamless tenant switching without re-authentication — POST /auth/exchange for new tenant-scoped tokens."
            delay={0.4}
            size={20}
            client:load
          />
          <AnimatedCard
            icon={UserIcon}
            title="Avatar Uploads"
            description="Two-phase presigned S3/MinIO flow, auto-cleanup old avatars, tenant-isolated storage."
            delay={0.5}
            size={20}
            client:load
          />
          <AnimatedCard
            icon={Database01Icon}
            title="Refunds API"
            description="Full refund management for tenants, PLATFORM_ADMIN global overview, Stripe integration."
            delay={0.6}
            size={20}
            client:load
          />
        </div>
      </section>
    </AnimatedSection>

    <!-- Included UI Applications -->
    <AnimatedSection client:load delay={0.2}>
      <section class="py-20">
        <h2 class="text-4xl font-bold text-center mb-4 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
          Two Production React SPAs
        </h2>
        <p class="text-center text-base-content/60 mb-12 text-lg">
          Ship with tenant-facing and platform-admin frontends — React 19, Mantine UI, and Feature-Sliced Design
        </p>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="card bg-base-100 border border-base-300 shadow-lg hover:shadow-xl transition-shadow">
            <div class="card-body">
              <div class="flex items-center gap-4 mb-4">
                <div class="p-3 bg-primary/10 rounded-xl">
                  <Icon icon={Globe02Icon} size={32} className="text-primary" client:load />
                </div>
                <h3 class="text-2xl font-bold text-primary">Tenant App</h3>
              </div>
              <p class="text-base-content/70 mb-6">
                The workspace interface for your customers. Scoped to a single tenant with dedicated session management.
              </p>
              <ul class="space-y-3 mb-8">
                <li class="flex items-center gap-2 text-sm">
                  <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
                  <span>Sign-in with tenant discovery & self-service signup</span>
                </li>
                <li class="flex items-center gap-2 text-sm">
                  <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
                  <span>Team management & invitation workflows</span>
                </li>
                <li class="flex items-center gap-2 text-sm">
                  <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
                  <span>Billing self-service & Stripe Customer Portal</span>
                </li>
                <li class="flex items-center gap-2 text-sm">
                  <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
                  <span>In-app notifications & announcements</span>
                </li>
                <li class="flex items-center gap-2 text-sm">
                  <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
                  <span>Lingui i18n support & Dark/Light themes</span>
                </li>
              </ul>
              <div class="card-actions justify-start">
                <span class="badge badge-outline">React 19</span>
                <span class="badge badge-outline">Mantine UI 9</span>
                <span class="badge badge-outline">TanStack Router</span>
              </div>
            </div>
          </div>

          <div class="card bg-base-100 border border-base-300 shadow-lg hover:shadow-xl transition-shadow">
            <div class="card-body">
              <div class="flex items-center gap-4 mb-4">
                <div class="p-3 bg-secondary/10 rounded-xl">
                  <Icon icon={Shield01Icon} size={32} className="text-secondary" client:load />
                </div>
                <h3 class="text-2xl font-bold text-secondary">Platform Admin</h3>
              </div>
              <p class="text-base-content/70 mb-6">
                Internal operator console for platform-wide administration. Manage the entire SaaS ecosystem.
              </p>
              <ul class="space-y-3 mb-8">
                <li class="flex items-center gap-2 text-sm">
                  <div class="w-1.5 h-1.5 rounded-full bg-secondary"></div>
                  <span>Dashboard with real-time metrics & count cards</span>
                </li>
                <li class="flex items-center gap-2 text-sm">
                  <div class="w-1.5 h-1.5 rounded-full bg-secondary"></div>
                  <span>Global User & Organization management</span>
                </li>
                <li class="flex items-center gap-2 text-sm">
                  <div class="w-1.5 h-1.5 rounded-full bg-secondary"></div>
                  <span>Subscription monitoring & Refunds overview</span>
                </li>
                <li class="flex items-center gap-2 text-sm">
                  <div class="w-1.5 h-1.5 rounded-full bg-secondary"></div>
                  <span>Global audit logs & announcements management</span>
                </li>
                <li class="flex items-center gap-2 text-sm">
                  <div class="w-1.5 h-1.5 rounded-full bg-secondary"></div>
                  <span>Plan catalog CRUD & RBAC enforcement</span>
                </li>
              </ul>
              <div class="card-actions justify-start">
                <span class="badge badge-outline">React 19</span>
                <span class="badge badge-outline">mantine-datatable</span>
                <span class="badge badge-outline">TanStack Query</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </AnimatedSection>

    <!-- Business benefits -->
    <AnimatedSection client:load delay={0.2}>
      <section class="py-20 bg-gradient-to-br from-base-200 to-base-100 rounded-3xl">
        <div class="max-w-5xl mx-auto px-4">
          <h2 class="text-4xl font-bold text-center mb-4 bg-gradient-to-r from-secondary to-accent bg-clip-text text-transparent">
            Built for Business Growth
          </h2>
          <p class="text-center text-base-content/60 mb-12 text-lg">
            Accelerate your journey from startup to scale-up
          </p>
          <div class="grid md:grid-cols-2 gap-6">
            <AnimatedCard
              icon={RocketIcon}
              title="Launch in Days"
              description="Skip months of infrastructure work. IAM, Gateway, and Billing are production-ready — deploy with Helm and start building your vertical."
              delay={0.1}
              size={20}
              client:load
            />
            <AnimatedCard
              icon={Shield01Icon}
              title="Security by Default"
              description="RS256 JWT, JTI denylist, brute-force lockout, header sanitization, BCrypt strength 12, and two-layer token revocation out of the box."
              delay={0.2}
              size={20}
              client:load
            />
            <AnimatedCard
              icon={SecurityLockIcon}
              title="True Data Isolation"
              description="Schema-per-tenant PostgreSQL with Liquibase per-tenant migrations. Tenant context flows automatically from JWT claims through the gateway."
              delay={0.3}
              size={20}
              client:load
            />
            <AnimatedCard
              icon={DollarSquareIcon}
              title="Zero Licensing Cost"
              description="Apache 2.0 — use it for personal projects, commercial products, or anything in between. No usage limits, no vendor lock-in."
              delay={0.4}
              size={20}
              client:load
            />
          </div>
        </div>
      </section>
    </AnimatedSection>
  </div>
</BaseLayout>
