---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "@/components/Icon";
import { IconBox } from "@/components/IconBox";
import {
  GithubIcon,
  SecurityLockIcon,
  CreditCardIcon,
  AnalyticsUpIcon,
  RocketIcon,
  Shield01Icon,
  DollarSquareIcon,
} from "@hugeicons/core-free-icons";
---

<BaseLayout title="IQ Scaffold - Enterprise Microservices Platform">
  <div class="container mx-auto px-4 py-16">
    <!-- Hero Section -->
    <section class="hero min-h-[600px]">
      <div class="hero-content text-center">
        <div class="max-w-4xl">
          <h1 class="text-5xl font-bold mb-6">
            Launch Your SaaS Product in Weeks, Not Months
          </h1>
          <p class="text-xl mb-4">
            Production-ready microservices platform with Identity, Payments, and
            CRM. Skip the infrastructure complexity and focus on building
            features your customers actually want.
          </p>
          <p class="text-lg mb-8 opacity-80">
            Open source, battle-tested, and designed for scale. Everything you
            need to go from idea to production.
          </p>
          <div
            class="flex flex-col sm:flex-row gap-4 justify-center items-center"
          >
            <a
              href="https://github.com/IQKV/microservices-platform"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-lg gap-2"
            >
              <Icon icon={GithubIcon} size={20} client:load />
              View on GitHub
            </a>
            <a href="/features" class="btn btn-outline btn-lg">
              Explore Platform
            </a>
          </div>
          <div class="badge badge-ghost mt-6">
            Free & Open Source • Apache 2.0 License • Production Ready
          </div>
        </div>
      </div>
    </section>

    <!-- Value Propositions -->
    <section class="py-20">
      <h2 class="text-3xl font-bold text-center mb-12">
        Everything You Need to Scale
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <IconBox icon={SecurityLockIcon} client:load />
            <h3 class="card-title">Identity & Access</h3>
            <p>
              Multi-tenant authentication, role-based access control, and secure
              user management out of the box
            </p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <IconBox icon={CreditCardIcon} client:load />
            <h3 class="card-title">Payment Operations</h3>
            <p>
              Accept payments, manage subscriptions, onboard merchants, and
              handle revenue sharing automatically
            </p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <IconBox icon={AnalyticsUpIcon} client:load />
            <h3 class="card-title">CRM & Sales</h3>
            <p>
              Complete lead-to-customer pipeline with scoring, conversion
              tracking, and sales analytics
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Business Benefits -->
    <section class="py-20 bg-base-200">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">
          Built for Business Growth
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="card bg-base-100 shadow-lg">
            <div class="card-body">
              <IconBox icon={RocketIcon} size={20} client:load />
              <h3 class="card-title text-lg">Launch Faster</h3>
              <p>
                Skip months of infrastructure development. Deploy essential
                business services in days.
              </p>
            </div>
          </div>
          <div class="card bg-base-100 shadow-lg">
            <div class="card-body">
              <IconBox icon={AnalyticsUpIcon} size={20} client:load />
              <h3 class="card-title text-lg">Scale Confidently</h3>
              <p>
                Multi-tenant architecture with data isolation, rate limiting,
                and fault tolerance built in.
              </p>
            </div>
          </div>
          <div class="card bg-base-100 shadow-lg">
            <div class="card-body">
              <IconBox icon={Shield01Icon} size={20} client:load />
              <h3 class="card-title text-lg">Stay Compliant</h3>
              <p>
                Security audit trails, data isolation, and encrypted credentials
                for regulated industries.
              </p>
            </div>
          </div>
          <div class="card bg-base-100 shadow-lg">
            <div class="card-body">
              <IconBox icon={DollarSquareIcon} size={20} client:load />
              <h3 class="card-title text-lg">Reduce Costs</h3>
              <p>
                Proven patterns and production-ready code eliminate expensive
                trial-and-error development.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
