---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { IconBox } from "@/components/IconBox";
import {
  SecurityLockIcon,
  CreditCardIcon,
  Globe02Icon,
  Database01Icon,
  BookOpen01Icon,
  Settings01Icon,
  Activity03Icon,
} from "@hugeicons/core-free-icons";
import { PlanSelector } from "@/components/PlanSelector";

interface PlanFeature {
  code: string;
  title: string;
  value: string;
  description?: string;
}

interface PlanFeatures {
  maxUsers: number;
  maxProjects: number;
  features: Record<string, PlanFeature>;
}

interface PublicPlanEntry {
  planCode: string;
  displayName: string;
  description?: string;
  billingPeriod: "MONTHLY" | "ANNUAL";
  priceMinor: number;
  currency: string;
  features: PlanFeatures;
  scope: string;
  active: boolean;
}

// Fallback shown when the API is unreachable at build time
const fallbackPlans: PublicPlanEntry[] = [
  {
    planCode: "free",
    displayName: "Free",
    description: "Get started for free. Upgrade anytime.",
    billingPeriod: "MONTHLY",
    priceMinor: 0,
    currency: "USD",
    features: {
      maxUsers: 1,
      maxProjects: 1,
      features: {},
    },
    scope: "TENANT",
    active: true,
  },
];

let plans: PublicPlanEntry[] = fallbackPlans;

// Try to fetch plans from API at build time
try {
  const apiUrl = import.meta.env.PUBLIC_API_URL;
  if (apiUrl) {
    const response = await fetch(`${apiUrl}/v1/billing/internal/plans/public`);
    if (response.ok) {
      plans = await response.json();
    }
  }
} catch (e) {
  console.warn("Failed to fetch plans from API, using fallback", e);
}
---

<BaseLayout title="Pricing - IQ Key Value">
  <div class="container mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">Simple Pricing</h1>
      <p class="text-lg max-w-2xl mx-auto">
        Choose the plan that fits your team's needs. All plans include our
        complete microservices platform.
      </p>
    </div>

    <!-- Client-side plan selector -->
    <PlanSelector client:load plans={plans} />

    <section class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-semibold mb-8 text-center">What's Included</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={SecurityLockIcon} client:load />
            <p class="font-medium">IAM — Identity & Access</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Globe02Icon} client:load />
            <p class="font-medium">Gateway — Reactive API Gateway</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={CreditCardIcon} client:load />
            <p class="font-medium">Billing — Stripe & Lemon Squeezy</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Activity03Icon} client:load />
            <p class="font-medium">Audit — Centralized Event Trail</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Database01Icon} client:load />
            <p class="font-medium">Hybrid Tenancy — B2B + B2C</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Settings01Icon} client:load />
            <p class="font-medium">Kubernetes + Helm Charts</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={BookOpen01Icon} client:load />
            <p class="font-medium">10-Stage CI/CD Pipeline</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-16 card bg-base-200 shadow-xl max-w-3xl mx-auto">
      <div class="card-body text-center">
        <h2 class="card-title justify-center text-xl">
          Questions about pricing?
        </h2>
        <p>
          Need a custom plan or have questions about what's included? Reach out
          to our team.
        </p>
        <a
          href="https://github.com/IQKV/microservices-platform/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-primary font-medium"
        >
          Join the discussion on GitHub →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
