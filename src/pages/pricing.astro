---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "@/components/Icon";
import { IconBox } from "@/components/IconBox";
import {
  Tick02Icon,
  SecurityLockIcon,
  CreditCardIcon,
  Globe02Icon,
  Database01Icon,
  BookOpen01Icon,
  GithubIcon,
  Settings01Icon,
  Activity03Icon,
} from "@hugeicons/core-free-icons";
---

<BaseLayout title="Pricing - IQ Key Value">
  <div class="container mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">Simple Pricing</h1>
      <p class="text-lg max-w-2xl mx-auto">
        Open source and free to use. Build your next SaaS product without
        licensing costs.
      </p>
    </div>

    <div class="max-w-md mx-auto mb-16">
      <div class="card bg-base-100 shadow-xl border-2 border-primary">
        <div class="card-body">
          <div class="text-center mb-6">
            <h3 class="card-title justify-center text-2xl">Open Source</h3>
            <div class="mb-2">
              <span class="text-5xl font-bold">$0</span>
              <span class="opacity-70">/forever</span>
            </div>
            <p class="text-sm">Apache 2.0 License</p>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>All 4 microservices included (IAM, Gateway, Billing, Audit)</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Production-ready code</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Complete documentation</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Community support via GitHub</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>No usage limits or restrictions</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon
                icon={Tick02Icon}
                size={20}
                className="text-primary flex-shrink-0 mt-0.5"
                client:load
              />
              <span>Commercial use allowed</span>
            </li>
          </ul>
          <div class="card-actions">
            <a
              href="https://github.com/IQKV/microservices-platform"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-block gap-2"
            >
              <Icon icon={GithubIcon} size={20} client:load />
              Get Started
            </a>
          </div>
        </div>
      </div>
    </div>

    <section class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-semibold mb-8 text-center">What's Included</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={SecurityLockIcon} client:load />
            <p class="font-medium">IAM — Identity & Access</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Globe02Icon} client:load />
            <p class="font-medium">Gateway — Reactive API Gateway</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={CreditCardIcon} client:load />
            <p class="font-medium">Billing — Stripe & Subscriptions</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Activity03Icon} client:load />
            <p class="font-medium">Audit — Centralized Event Trail</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Database01Icon} client:load />
            <p class="font-medium">Hybrid Tenancy — B2B + B2C</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Settings01Icon} client:load />
            <p class="font-medium">Kubernetes + Helm Charts</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={BookOpen01Icon} client:load />
            <p class="font-medium">10-Stage CI/CD Pipeline</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-16 card bg-base-200 shadow-xl max-w-3xl mx-auto">
      <div class="card-body text-center">
        <h2 class="card-title justify-center text-xl">
          Questions about pricing?
        </h2>
        <p>
          IQ Key Value is completely free and open source under the Apache 2.0
          license. Use it for personal projects, commercial products, or
          anything in between.
        </p>
        <a
          href="https://github.com/IQKV/microservices-platform/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-primary font-medium"
        >
          Join the discussion on GitHub →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
