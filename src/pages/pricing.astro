---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "@/components/Icon";
import { IconBox } from "@/components/IconBox";
import {
  Tick02Icon,
  SecurityLockIcon,
  CreditCardIcon,
  Globe02Icon,
  Database01Icon,
  BookOpen01Icon,
  GithubIcon,
  Settings01Icon,
  Activity03Icon,
} from "@hugeicons/core-free-icons";

interface PlanFeatures {
  prioritySupport: boolean;
  maxUsers: number;
  maxProjects: number;
}

interface PublicPlanEntry {
  planCode: string;
  displayName: string;
  description?: string;
  billingPeriod: "MONTHLY" | "ANNUAL";
  priceMinor: number;
  currency: string;
  features: PlanFeatures;
  scope: string;
  active: boolean;
}

// Fallback data
const fallbackPlans: PublicPlanEntry[] = [
  {
    planCode: "basic-monthly",
    displayName: "Basic Monthly",
    description: "A basic plan for small teams with limited support.",
    billingPeriod: "MONTHLY",
    priceMinor: 500,
    currency: "USD",
    features: {
      prioritySupport: false,
      maxUsers: 5,
      maxProjects: 3,
    },
    scope: "TENANT",
    active: true,
  },
  {
    planCode: "pro-monthly",
    displayName: "Pro Monthly",
    description: "A pro plan for larger teams with priority support.",
    billingPeriod: "MONTHLY",
    priceMinor: 1500,
    currency: "USD",
    features: {
      prioritySupport: true,
      maxUsers: 50,
      maxProjects: 0,
    },
    scope: "TENANT",
    active: true,
  },
];

let plans: PublicPlanEntry[] = fallbackPlans;

// Try to fetch plans from API at build time
try {
  const apiUrl = import.meta.env.PUBLIC_API_URL;
  if (apiUrl) {
    const response = await fetch(`${apiUrl}/v1/billing/internal/plans/public`);
    if (response.ok) {
      plans = await response.json();
    }
  }
} catch (e) {
  console.warn("Failed to fetch plans from API, using fallback", e);
}

// Helper to format price
function formatPrice(priceMinor: number, currency: string) {
  const major = priceMinor / 100;
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: currency,
    minimumFractionDigits: 0,
    maximumFractionDigits: 2,
  }).format(major);
}

// Group plans by billing period
const monthlyPlans = plans.filter((p) => p.billingPeriod === "MONTHLY");
const annualPlans = plans.filter((p) => p.billingPeriod === "ANNUAL");
---

<BaseLayout title="Pricing - IQ Key Value">
  <div class="container mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">Simple Pricing</h1>
      <p class="text-lg max-w-2xl mx-auto">
        Choose the plan that fits your team's needs. All plans include our
        complete microservices platform.
      </p>
    </div>

    <!-- Toggle for Monthly/Annual -->
    <div class="flex justify-center mb-12">
      <div class="inline-flex bg-base-100 p-1 rounded-lg shadow-lg">
        <button class="px-4 py-2 rounded-md bg-primary text-primary-content font-medium">
          Monthly
        </button>
        <button class="px-4 py-2 rounded-md font-medium">Annual</button>
      </div>
    </div>

    <!-- Plan Cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto mb-16">
      {monthlyPlans.map((plan) => (
        <div key={plan.planCode} class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <div class="text-center mb-6">
              <h3 class="card-title justify-center text-2xl">{plan.displayName}</h3>
              {plan.description && (
                <p class="text-sm text-base-content/70 mt-2">{plan.description}</p>
              )}
              <div class="mb-2 mt-4">
                <span class="text-5xl font-bold">{formatPrice(plan.priceMinor, plan.currency)}</span>
                <span class="opacity-70">/month</span>
              </div>
            </div>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-2">
                <Icon
                  icon={Tick02Icon}
                  size={20}
                  className="text-primary flex-shrink-0 mt-0.5"
                  client:load
                />
                <span>
                  {plan.features.maxUsers === 0 ? "Unlimited" : plan.features.maxUsers} Users
                </span>
              </li>
              <li class="flex items-start gap-2">
                <Icon
                  icon={Tick02Icon}
                  size={20}
                  className="text-primary flex-shrink-0 mt-0.5"
                  client:load
                />
                <span>
                  {plan.features.maxProjects === 0 ? "Unlimited" : plan.features.maxProjects} Projects
                </span>
              </li>
              <li class="flex items-start gap-2">
                <Icon
                  icon={Tick02Icon}
                  size={20}
                  className="text-primary flex-shrink-0 mt-0.5"
                  client:load
                />
                <span>
                  {plan.features.prioritySupport ? "Priority" : "Community"} Support
                </span>
              </li>
            </ul>
            <div class="card-actions">
              <a href={import.meta.env.PUBLIC_APP_URL || "/"} class="btn btn-primary btn-block">
                Get Started
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <section class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-semibold mb-8 text-center">What's Included</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={SecurityLockIcon} client:load />
            <p class="font-medium">IAM — Identity & Access</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Globe02Icon} client:load />
            <p class="font-medium">Gateway — Reactive API Gateway</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={CreditCardIcon} client:load />
            <p class="font-medium">Billing — Stripe & Subscriptions</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Activity03Icon} client:load />
            <p class="font-medium">Audit — Centralized Event Trail</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Database01Icon} client:load />
            <p class="font-medium">Hybrid Tenancy — B2B + B2C</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={Settings01Icon} client:load />
            <p class="font-medium">Kubernetes + Helm Charts</p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body items-center text-center">
            <IconBox icon={BookOpen01Icon} client:load />
            <p class="font-medium">10-Stage CI/CD Pipeline</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-16 card bg-base-200 shadow-xl max-w-3xl mx-auto">
      <div class="card-body text-center">
        <h2 class="card-title justify-center text-xl">
          Questions about pricing?
        </h2>
        <p>
          Need a custom plan or have questions about what's included? Reach out
          to our team.
        </p>
        <a
          href="https://github.com/IQKV/microservices-platform/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-primary font-medium"
        >
          Join the discussion on GitHub →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
