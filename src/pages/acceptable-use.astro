---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Acceptable Use Policy — iQ Key Value">
  <div class="container mx-auto px-4 py-16 max-w-4xl">
    <h1 class="text-4xl font-bold mb-8 text-center">Acceptable Use Policy</h1>
    <div class="space-y-8">
      <section class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl">1. Purpose</h2>
          <p class="text-base-content/80">
            This Acceptable Use Policy outlines the rules and guidelines for using the iQ Key Value Service. By using the Service, you agree to comply with this policy.
          </p>
        </div>
      </section>
      <section class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl">2. Prohibited Activities</h2>
          <ul class="list-disc list-inside space-y-2 text-base-content/80">
            <li>Violating any applicable laws or regulations</li>
            <li>Infringing on the intellectual property rights of others</li>
            <li>Uploading or distributing malicious software</li>
            <li>Attempting to gain unauthorized access to the Service or other users' accounts</li>
            <li>Interfering with or disrupting the Service</li>
            <li>Using the Service for any illegal or unauthorized purpose</li>
            <li>Harassing, threatening, or intimidating other users</li>
            <li>Spamming or sending unsolicited messages</li>
          </ul>
        </div>
      </section>
      <section class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl">3. Content Standards</h2>
          <p class="text-base-content/80">
            You agree not to upload, post, or otherwise transmit any content that is:
          </p>
          <ul class="list-disc list-inside space-y-2 text-base-content/80 mt-2">
            <li>Unlawful, harmful, threatening, abusive, harassing, tortious, defamatory, vulgar, obscene, libelous, or invasive of another's privacy</li>
            <li>Infringing on any patent, trademark, trade secret, copyright, or other proprietary rights of any party</li>
            <li>Containing software viruses or any other computer code, files, or programs designed to interrupt, destroy, or limit the functionality of any computer software or hardware</li>
          </ul>
        </div>
      </section>
      <section class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl">4. Account Security</h2>
          <p class="text-base-content/80">
            You are responsible for maintaining the confidentiality of your account and password and for restricting access to your computer. You agree to accept responsibility for all activities that occur under your account or password.
          </p>
        </div>
      </section>
      <section class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl">5. Enforcement</h2>
          <p class="text-base-content/80">
            We reserve the right to take appropriate action against any user who violates this policy, including but not limited to:
          </p>
          <ul class="list-disc list-inside space-y-2 text-base-content/80 mt-2">
            <li>Warning the user</li>
            <li>Suspending or terminating the user's account</li>
            <li>Removing or modifying content</li>
            <li>Reporting violations to law enforcement authorities</li>
          </ul>
        </div>
      </section>
      <section class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl">6. Changes to This Policy</h2>
          <p class="text-base-content/80">
            We may update this Acceptable Use Policy from time to time. We will notify you of any changes by posting the new policy on this page.
          </p>
        </div>
      </section>
      <section class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl">7. Contact Us</h2>
          <p class="text-base-content/80">
            If you have any questions about this Acceptable Use Policy, please contact us through our GitHub repository.
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
