---
import "@/styles/globals.css";
import { AuthIsland } from "@/components/AuthIsland";
import { TopNav } from "@/components/TopNav";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "IQ Key Value",
  description = "Open source microservices platform for building scalable SaaS products",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="flex flex-col min-h-screen" data-theme="light">
    <!--
      AuthIsland runs first (client:only) so the Zustand store is populated
      before TopNav reads isAuthenticated / isLoading.
    -->
    <AuthIsland client:only="react" />
    <TopNav client:load />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Cookie consent banner -->
    <div id="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookie notice" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;padding:1rem;background:#111c2b;border-top:2px solid #3b4ef0;">
      <div style="max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
        <p style="margin:0;color:#b0bac9;font-size:0.875rem;">
          We use cookies to improve your experience. By continuing to use this site you accept our use of cookies.
          <a href="https://iqkv.com/cookies" style="color:#3b4ef0;text-decoration:underline;margin-left:0.25rem;">Learn more</a>
        </p>
        <button id="cookie-accept" type="button" style="flex-shrink:0;padding:0.5rem 1.5rem;background:#3b4ef0;color:#fff;border:none;border-radius:4px;font-size:0.875rem;font-weight:600;cursor:pointer;white-space:nowrap;">
          Got it
        </button>
      </div>
    </div>

    <script is:inline>
      (function () {
        if (!localStorage.getItem("cookie_consent")) {
          document.getElementById("cookie-banner").style.display = "block";
        }
        document.getElementById("cookie-accept").addEventListener("click", function () {
          localStorage.setItem("cookie_consent", "1");
          document.getElementById("cookie-banner").style.display = "none";
        });
      })();
    </script>
  </body>
</html>
