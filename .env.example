# ─── Auth & App ───────────────────────────────────────────────────────────────
# Base URL of the IAM / API gateway (used by AuthIsland for token refresh).
# Must expose POST /v1/iam/auth/refresh with X-Tenant-ID header support.
PUBLIC_AUTH_URL=https://api.iqkv.site/api

# Base URL of the foundation-ui-app (used for Login / Sign Up / Dashboard links).
PUBLIC_APP_URL=https://app.iqkv.site

# Base URL of the API gateway (used for fetching pricing plans).
PUBLIC_API_URL=https://api.iqkv.site/api

# ─── Site ─────────────────────────────────────────────────────────────────────
PUBLIC_SITE_NAME=IQ Key Value
PUBLIC_SITE_URL=https://www.iqkv.site
