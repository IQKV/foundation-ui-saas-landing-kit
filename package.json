{
  "name": "@iqkv/foundation-ui-saas-landing-kit",
  "version": "0.0.0",
  "description": "A simple SaaS landing page kit with Astro, React, Tailwind CSS, and DaisyUI",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "dev": "astro dev",
    "formatter:check": "oxfmt --check",
    "formatter:write": "oxfmt --write",
    "lint": "pnpm lint:eslint",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:eslint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "node_modules:cleanup": "rm -rf node_modules",
    "prepare": "husky",
    "preview": "astro preview",
    "release": "release-it --ci"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^5.0.6",
    "@astrojs/tailwind": "^6.0.2",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "astro": "^6.4.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "cz-conventional-changelog": "^3.3.0",
    "daisyui": "^5.5.20",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "husky": "9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "prettier-plugin-astro": "^0.14.1",
    "release-it": "^20.0.1",
    "release-it-pnpm": "^4.6.6",
    "sort-package-json": "^4.0.0",
    "tsdown": "^0.22.1",
    "typescript-eslint": "^8.60.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "oxlint --type-aware",
      "oxfmt --write"
    ],
    "*.{css,json,md}": [
      "oxfmt --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.0.8"
}
