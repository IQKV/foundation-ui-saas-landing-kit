{
  "name": "@iqscaffold/standard-saas-landing-kit",
  "version": "0.0.0",
  "description": "A simple SaaS landing page kit with Astro, React, Tailwind CSS, and DaisyUI",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "dev": "astro dev",
    "formatter:check": "prettier . --check --ignore-unknown",
    "formatter:write": "prettier . --write",
    "lint": "pnpm lint:eslint",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:eslint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "node_modules:cleanup": "rm -rf node_modules",
    "prepare": "husky",
    "preview": "astro preview",
    "release": "release-it --ci"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^4.4.2",
    "@astrojs/tailwind": "^6.0.2",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.5",
    "astro": "^5.18.0",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^9.39.4",
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cz-conventional-changelog": "^3.3.0",
    "daisyui": "^5.5.19",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "glob": "^13.0.6",
    "globals": "^17.4.0",
    "husky": "9.1.7",
    "lint-staged": "^16.3.2",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-packagejson": "3.0.2",
    "release-it": "^19.2.4",
    "release-it-pnpm": "^4.6.6",
    "sort-package-json": "^3.6.1",
    "tsdown": "^0.21.1",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.13.0"
  }
}
